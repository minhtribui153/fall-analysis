# General configuration
DIR_DATA="./.data"                      # set to an appropriate virtual folder you need

# PostgreSQL database configuration
POSTGRES_DB="<your_postgres_db>"
POSTGRES_USER="<your_postgres_user>"
POSTGRES_PASSWORD="<your_postgres_password>"

# PGAdmin console configuration
PGADMIN_DEFAULT_EMAIL="<your_default_login_email>"
PGADMIN_DEFAULT_PASSWORD="<your_default_login_password>"
# BLE gateway -> MQTT configuration
# If Mosquitto runs on the same PC/Raspberry Pi as n1_registration_server.py,
# 127.0.0.1 is correct. Otherwise use the broker machine's LAN IP.
MQTT_HOST="127.0.0.1"
MQTT_PORT="1883"
MQTT_TOPIC="sensor-readings"
MQTT_CLIENT_ID="tervanix-ble-gateway"
# MQTT_USERNAME=""
# MQTT_PASSWORD=""
