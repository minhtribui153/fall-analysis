# Virtual data directory
DIR_DATA="./.data"

# PostgreSQL database configuration
POSTGRES_DB="<your_postgres_db>"
POSTGRES_USER="<your_postgres_user>"
POSTGRES_PASSWORD="<your_postgres_password>"
POSTGRES_HOST="<your_postgres_hostname_or_ip>"
POSTGRES_PORT="<your_postgres_port_number>"

# PGAdmin console configuration
PGADMIN_DEFAULT_EMAIL="<your_postgres_email>"
PGADMIN_DEFAULT_PASSWORD="<your_postgres_password>"

# Main Registration Server configuration
REGISTRATION_ADMIN_HOST="0.0.0.0" # Use either 0.0.0.0 or 127.0.0.1
REGISTRATION_ADMIN_PORT="8765"
REGISTRATION_ADMIN_TOKEN="<your_secret_passphrase_here_for_admin>"
REGISTRATION_SESSION_TTL_SECONDS="28800"

# HAR Model Configuration
#HAR_MODEL_PATH="./detection/models/har_model.tflite"
HAR_MODEL_ID="<your_own_model_id>"
HAR_MODEL_MIN_CONFIDENCE="0.60"
HAR_INFERENCE_SAMPLE_PERIOD_MS="40"
HAR_INFERENCE_WINDOW_MS="1500"
HAR_PREDICTION_INTERVAL_MS="1000"
HAR_OFFLINE_PURGE_UNKNOWN_FIRST="true" # Purge -> '1', 'yes', 'true'; Do not purge -> '0', 'no', 'false'
HAR_OFFLINE_REPLAY_BATCH_SIZE="10"

# MQTT Server Configuration
# If Mosquitto runs on the same PC/Raspberry Pi as n1_registration_server.py,
# 127.0.0.1 is correct. Otherwise use the broker machine's LAN IP.
MQTT_HOST="127.0.0.1"
MQTT_PORT="1883"
MQTT_KEEPALIVE="60"
MQTT_TELEMETRY_SUBSCRIPTION="tervanix/sessions/+/telemetry"
MQTT_QOS="0"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_QUEUE_SIZE="2000"

# Miscellaneous
SAMPLE_RATE_HZ="100"
READING_BATCH_SIZE="50"
LAST_SEEN_UPDATE_SECONDS="5"