#include <TensorFlowLite_ESP32.h>
#include "tensorflow/lite/micro/all_ops_resolver.h"
#include "tensorflow/lite/micro/micro_interpreter.h"
#include "tensorflow/lite/schema/schema_generated.h"
#include "model.h" // The file containing your har_model[] array
#include "tensorflow/lite/micro/micro_error_reporter.h"
#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLEUtils.h>
#include <BLE2902.h>

// Define unique UUIDs for the BLE Service and Characteristic
#define SERVICE_UUID        "4fafc201-1fb5-459e-8fcc-c5c9c331914b"
#define CHARACTERISTIC_UUID "beb5483e-36e1-4688-b7f5-ea07361b26a8" 

// --- TFLite Globals ---
const tflite::Model* model = nullptr;
tflite::MicroInterpreter* interpreter = nullptr;
TfLiteTensor* input = nullptr;
TfLiteTensor* output = nullptr;
tflite::ErrorReporter* error_reporter = nullptr;

// Allocate memory for the model's tensors. 
// You may need to tweak this size (e.g., 20 * 1024) if the ESP32 crashes on boot.
constexpr int kTensorArenaSize = 15 * 1024;
uint8_t tensor_arena[kTensorArenaSize];

// --- BLE Globals ---
BLEServer* pServer = NULL;
BLECharacteristic* pCharacteristic = NULL;
bool deviceConnected = false;

// Callbacks to handle PC connecting and disconnecting
class MyServerCallbacks: public BLEServerCallbacks {
    void onConnect(BLEServer* pServer) {
      deviceConnected = true;
      Serial.println("PC Connected via BLE!");
    };
    void onDisconnect(BLEServer* pServer) {
      deviceConnected = false;
      Serial.println("PC Disconnected.");
      // Restart advertising so it can reconnect
      BLEDevice::startAdvertising(); 
    }
};

void setupBLE() {
  BLEDevice::init("Nesso_N1_HAR"); // The name your PC will look for
  pServer = BLEDevice::createServer();
  pServer->setCallbacks(new MyServerCallbacks());

  BLEService *pService = pServer->createService(SERVICE_UUID);

  pCharacteristic = pService->createCharacteristic(
                      CHARACTERISTIC_UUID,
                      BLECharacteristic::PROPERTY_NOTIFY
                    );
  
  // Required for the PC to subscribe to the live stream
  pCharacteristic->addDescriptor(new BLE2902());

  pService->start();
  BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();
  pAdvertising->addServiceUUID(SERVICE_UUID);
  pAdvertising->setScanResponse(false);
  pAdvertising->setMinPreferred(0x0);
  BLEDevice::startAdvertising();
  Serial.println("BLE Started. Waiting for PC to connect...");
}

void setup() {
    Serial.begin(115200);
    setupBLE();
    
    // Set up the error reporter
    static tflite::MicroErrorReporter micro_error_reporter;
    error_reporter = &micro_error_reporter;

    // 1. Load the model from the C array
    model = tflite::GetModel(har_model);
    if (model->version() != TFLITE_SCHEMA_VERSION) {
        TF_LITE_REPORT_ERROR(error_reporter, "Error: Model schema mismatch!");
        return;
    }

    // 2. Pull in the operations the model needs
    static tflite::AllOpsResolver resolver;

    // 3. Build the interpreter
    static tflite::MicroInterpreter static_interpreter(
        model, resolver, tensor_arena, kTensorArenaSize, error_reporter);
    interpreter = &static_interpreter;

    // 4. Allocate memory for the tensors
    if (interpreter->AllocateTensors() != kTfLiteOk) {
        TF_LITE_REPORT_ERROR(error_reporter, "AllocateTensors() failed");
        return;
    }

    // Assign pointers to the input and output tensors
    input = interpreter->input(0);
    output = interpreter->output(0);
    
    Serial.println("TFLite Model successfully loaded and ready.");
}

// 5. Define your window and buffer requirements
const int samples_per_window = 75; // 3 seconds at 25Hz
const int num_axes = 6;            // ax, ay, az, gx, gy, gz
const int slide_step = 38;         // Slide by ~1.5 seconds (38 samples)

// 2D Buffer to store continuous IMU data
float imu_buffer[samples_per_window][num_axes];
int current_sample_index = 0;
unsigned long last_sample_time = 0;
const unsigned long sample_interval_ms = 40; // 25Hz = 40ms per sample

void loop() {
    // Non-blocking timer to sample exactly at 25Hz
    unsigned long current_time = millis();
    if (current_time - last_sample_time >= sample_interval_ms) {
        last_sample_time = current_time;

        // --- READ YOUR IMU DATA HERE ---
        // Replacing mock zeros with mock random data. 
        // Replace these lines with your actual MPU6050 / IMU library read functions.
        float ax = random(-100, 100) / 100.0f;
        float ay = random(-100, 100) / 100.0f;
        float az = random(-100, 100) / 100.0f;
        float gx = random(-200, 200) / 10.0f;
        float gy = random(-200, 200) / 10.0f;
        float gz = random(-200, 200) / 10.0f;

        // Store into the sliding window buffer
        imu_buffer[current_sample_index][0] = ax;
        imu_buffer[current_sample_index][1] = ay;
        imu_buffer[current_sample_index][2] = az;
        imu_buffer[current_sample_index][3] = gx;
        imu_buffer[current_sample_index][4] = gy;
        imu_buffer[current_sample_index][5] = gz;
        
        current_sample_index++;

        // Once we have collected enough samples for a full window...
        if (current_sample_index >= samples_per_window) {
            
            // 6. Populate the input tensor
            int tensor_idx = 0;
            for (int i = 0; i < samples_per_window; i++) {
                for (int j = 0; j < num_axes; j++) {
                    // Note: If using quantized INT8 model, you must scale & zero-point map this float.
                    // Assuming float32 model for this example:
                    input->data.f[tensor_idx++] = imu_buffer[i][j]; 
                }
            }

            // 7. Run inference
            if (interpreter->Invoke() != kTfLiteOk) {
                Serial.println("Invoke failed!");
                return;
            }

            // 8. Read the output predictions
            float max_prob = 0.0f;
            int predicted_class = -1;
            int num_classes = 8; // Adjust based on your actual labels
            
            for (int i = 0; i < num_classes; i++) {
                float prob = output->data.f[i]; 
                if (prob > max_prob) {
                    max_prob = prob;
                    predicted_class = i;
                }
            }

            // 9. Output the result locally
            Serial.print("Detected Pattern Class: ");
            Serial.print(predicted_class);
            Serial.print(" | Confidence: ");
            Serial.println(max_prob);

            // 10. Send via BLE if connected
            if (deviceConnected) {
                // Package the latest snapshot of data alongside the prediction
                String blePayload = String(ax) + "," + String(ay) + "," + String(az) + "," + 
                                    String(gx) + "," + String(gy) + "," + String(gz) + "," + 
                                    String(predicted_class) + "," + String(max_prob);

                pCharacteristic->setValue(blePayload.c_str());
                pCharacteristic->notify();
                
                Serial.println("Sent BLE: " + blePayload);
            }

            // 11. Slide the window for the overlap.
            // Move the newest samples back to the beginning of the array.
            int remaining_samples = samples_per_window - slide_step;
            for (int i = 0; i < remaining_samples; i++) {
                for (int j = 0; j < num_axes; j++) {
                    imu_buffer[i][j] = imu_buffer[i + slide_step][j];
                }
            }
            
            // Set the index so the next reads fill in the remaining space
            current_sample_index = remaining_samples;
        }
    }
}