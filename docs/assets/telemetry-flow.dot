digraph G {
  rankdir=TB; graph [bgcolor="transparent", pad="0.2"]; node [shape=box, style="rounded", fontname="Arial"];
  sample [label="Read BMI270 sample"];
  har [label="HAR inference window\nconfidence < threshold?\nthen local heuristic fallback"];
  batch [label="Add to 10-reading batch\nattach current prediction if available"];
  conn [shape=diamond,label="MQTT publish accepted?"];
  live [label="Encrypted MQTT telemetry"];
  flash [label="Write batch to 512 KiB flash journal"];
  replay [label="Reconnect -> peek oldest -> republish -> tombstone"];
  decrypt [label="Server authenticate + AES-GCM decrypt"];
  pred [label="Store Nesso prediction"];
  rules [label="Run server FallDetector\non every raw reading"];
  db [label="PostgreSQL"];
  sample -> har -> batch -> conn;
  conn -> live [label="yes"];
  conn -> flash [label="no"];
  flash -> replay -> live;
  live -> decrypt;
  decrypt -> pred -> db;
  decrypt -> rules -> db;
}