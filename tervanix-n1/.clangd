CompileFlags:
  CompilationDatabase: .
  Add:
    - --target=riscv32-esp-elf
    - -std=gnu17
  Remove:
    - -mlongcalls
    - -mtext-section-literals
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fno-shrink-wrap
    - -fmacro-prefix-map=*
    - -ffile-prefix-map=*
    - -fdebug-prefix-map=*
    - -fzero-init-padding-bits=all
    - -fno-malloc-dce

Diagnostics:
  Suppress:
    - expected
    - pp_file_not_found
    - implicit_function_decl
    - undeclared_var_use
    - unknown_typename
    - unused-includes
    - unused-macros