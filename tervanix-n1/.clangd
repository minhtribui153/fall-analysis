CompileFlags:
  CompilationDatabase: .
  Remove:
    - -mlongcalls
    - -mdisable-hardware-atomics
    - -mfix-esp32-psram-cache-issue
    - -mfix-esp32-psram-cache-strategy=*
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fno-shrink-wrap

Diagnostics:
  Suppress:
    - expected
    - pp_file_not_found
    - implicit_function_decl
    - undeclared_var_use
    - unknown_typename
    - unused-includes
    - unused-macros
    - redefinition_different_kind
    - undeclared_var_use_suggest